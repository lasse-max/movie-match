# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.
#
# Both keys are read SERVER-SIDE ONLY (inside app/api/* route handlers via
# process.env). They are NOT prefixed with NEXT_PUBLIC_, so they are never
# bundled into client code or exposed to the browser.

# TMDB — movie metadata, genres, and watch-provider availability.
# Use the v4 Read Access Token (Settings → API → "API Read Access Token").
# Get one at https://www.themoviedb.org/settings/api
# Sent as: Authorization: Bearer <token>
TMDB_READ_ACCESS_TOKEN=

# Anthropic / Claude — used for the 2 taste-blend calls per session (added in a later step).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- Embeddings v1 (Track A) ----------------------------------------------
# All three are SERVER-SIDE ONLY. None are prefixed with NEXT_PUBLIC_.

# OpenAI — embeds the film catalogue (text-embedding-3-small). Used ONLY by
# scripts/build-catalog.mjs, offline. There is NO OpenAI call during a game, so
# this is not needed in production; keep it in .env.local only.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Supabase — the Movie Match project (Postgres + pgvector) holding the film
# vectors. Project Settings → API. The service role key BYPASSES row-level
# security, so it must never be NEXT_PUBLIC_ and never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Embeddings kill switch. Off until the eval gate (E4) passes. Read server-side
# only; it is never a user-facing toggle.
EMBEDDINGS_ENABLED=false
